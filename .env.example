# GhostMeter Environment Variables
# Copy this file to .env.local and fill in your values

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GhostMeter

# Analytics (Optional - for production)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_PREMIUM=true
NEXT_PUBLIC_MAX_FREE_ANALYSES=3

# Rate Limiting (per day)
RATE_LIMIT_MAX=3

# AI Configuration (automatically provided by z-ai-web-dev-sdk)
# No additional configuration needed for the AI SDK

# Groq API (used by /api/coach for the relationship coach LLM)
# Get a free key at https://console.groq.com/keys
# Without this key, the coach will silently fall back to static canned replies
# (which is why responses feel repetitive — the LLM is never actually called).
GROQ_API_KEY=

# Groq model name (optional — defaults to llama-3.1-8b-instant, available on free tier)
# Other options: llama3-70b-8192 (more powerful, may require paid plan),
#                gemma2-9b-it, mixtral-8x7b-32768
# Change this if Groq ever deprecates the default model.
GROQ_MODEL=llama-3.1-8b-instant

# Admin Configuration
ADMIN_PASSWORD=ghostmeter2024